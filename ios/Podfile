# Uncomment this line to define a global platform for your project
platform :ios, '12.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  # Try multiple possible paths for Generated.xcconfig
  possible_paths = [
    File.expand_path(File.join('Flutter', 'Generated.xcconfig'), __dir__),
    File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __dir__),
    File.expand_path(File.join('..', '..', 'Flutter', 'Generated.xcconfig'), __dir__)
  ]
  
  generated_xcode_build_settings_path = possible_paths.find { |path| File.exist?(path) }
  
  unless generated_xcode_build_settings_path
    # Fallback: use environment variable or default
    flutter_root = ENV['FLUTTER_ROOT'] || '/opt/hostedtoolcache/flutter/stable-3.24.5-x64/flutter'
    return flutter_root
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  
  # Fallback if FLUTTER_ROOT not found in file
  ENV['FLUTTER_ROOT'] || '/opt/hostedtoolcache/flutter/stable-3.24.5-x64/flutter'
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
  end
end
